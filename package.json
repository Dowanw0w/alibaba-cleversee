{
  "name": "multi-access",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Aliyun CleverSee web search and page fetch, shipped as a Pi extension and CLI",
  "pi": {
    "extensions": [
      "./extension/index.mjs"
    ]
  },
  "bin": {
    "multi-access": "bin/multi-access.mjs"
  },
  "files": [
    "bin",
    "src",
    "extension",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/multi-access.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "MULTI_ACCESS_LIVE=1 node --test test/live.test.mjs"
  },
  "author": "Dowan",
  "license": "UNLICENSED"
}
