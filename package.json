{
  "name": "@dowanw0w/alibaba-cleversee",
  "version": "1.0.2",
  "description": "Unofficial Pi extension and CLI for Alibaba Cloud CleverSee web search and page fetch",
  "type": "module",
  "license": "MIT",
  "author": "Dowanw0w <46449568+Dowanw0w@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dowanw0w/alibaba-cleversee.git"
  },
  "homepage": "https://github.com/Dowanw0w/alibaba-cleversee#readme",
  "bugs": {
    "url": "https://github.com/Dowanw0w/alibaba-cleversee/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cleversee",
    "aliyun",
    "web-search",
    "web-fetch",
    "readpage"
  ],
  "pi": {
    "extensions": [
      "./extension/index.mjs"
    ]
  },
  "bin": {
    "alibaba-cleversee": "bin/alibaba-cleversee.mjs"
  },
  "files": [
    "bin",
    "src",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/alibaba-cleversee.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "CLEVERSEE_LIVE=1 node --test test/live.test.mjs"
  },
  "private": true
}
